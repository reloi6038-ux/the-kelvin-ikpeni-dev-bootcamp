# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/kelvin-bootcamp?retryWrites=true&w=majority

# ---- Sessions & Security (generate strong random values) ----
SESSION_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=false

# ---- Admin Bootstrap (used once in Phase 12 to create the first admin) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password